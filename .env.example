# ---- Required in production ----
# Public URL of the platform (tracking snippet, webhooks, emails).
PUBLIC_URL=https://app.example.com
# Encrypts ad platform tokens at rest. Generate: openssl rand -hex 32
SECRET_KEY=
NODE_ENV=production
SECURE_COOKIES=1

# ---- Brand ----
APP_NAME=Tracking
SUPPORT_EMAIL=support@example.com
# Set to 0 to close public signups (invite-only).
SIGNUP_ENABLED=1
TRIAL_DAYS=14

# ---- Email (https://resend.com) ----
RESEND_API_KEY=
EMAIL_FROM=Tracking <no-reply@example.com>

# ---- Payments (https://moyasar.com) ----
MOYASAR_SECRET_KEY=
# Secret set on the webhook in Moyasar dashboard → Settings → Webhooks.
MOYASAR_WEBHOOK_SECRET=

# ---- Optional: first platform owner on boot (otherwise the first signup) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Data ----
DB_PATH=/data/tracking.db
TZ_OFFSET=+03:00
BACKUP_KEEP_DAYS=14
RETENTION_DAYS=400
SYNC_INTERVAL_MINUTES=60

# ---- Ad platform OAuth apps (only to refresh tokens) ----
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_API_VERSION=v25.0
GOOGLE_ADS_API_VERSION=v24
