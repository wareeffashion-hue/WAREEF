{#
  Wareef — Editorial split hero: tall image + floating second image, copy, optional featured product mini-card.
#}
{% set kicker = component.kicker %}{% set kicker = kicker is iterable ? (kicker[language.code]|default(kicker|first)) : kicker %}
{% set title = component.title %}{% set title = title is iterable ? (title[language.code]|default(title|first)) : title %}
{% set text = component.text %}{% set text = text is iterable ? (text[language.code]|default(text|first)) : text %}
{% set btn = component.button %}{% set btn = btn is iterable ? (btn[language.code]|default(btn|first)) : btn %}
{% set url = component.url %}{% set url = url is iterable ? (url.url|default('')) : url %}
{% set side = component.image_side %}{% set side = side is iterable ? ((side|first).value|default(side.value|default('start'))) : side %}
{% set product = component.products is iterable and component.products|length ? component.products|first : null %}
{% set img = component.image ?: ('images/wareef/look1.jpg'|asset) %}
{% set img2 = component.image2 ?: ('images/wareef/look3.jpg'|asset) %}
<section component-id="{{ componentId }}" class="w-block w-hero-split{{ side == 'end' ? ' w-hero-split--flip' : '' }}" data-testid="w-hero-split">
  <div class="container">
    <div class="w-hero-split__grid">
      <div class="w-hero-split__visual">
        <div class="w-media w-hero-split__main" data-w-reveal="mask">
          <div class="w-hero-split__par" data-w-parallax="0.06">
            <img src="{{ img }}" alt="{{ title|default(store.name)|e }}" width="1200" height="1500" fetchpriority="high" decoding="async">
          </div>
        </div>
        <div class="w-media w-hero-split__float" data-w-reveal="mask" style="--i: 3">
          <img src="{{ img2 }}" alt="" width="800" height="1000" loading="lazy" decoding="async">
        </div>
        <span class="w-hero-split__tag" aria-hidden="true">{{ store.name|default('Wareef') }}</span>
      </div>
      <div class="w-hero-split__copy" data-w-stagger>
        {% if kicker %}<span class="w-kicker" data-w-reveal>{{ kicker }}</span>{% endif %}
        {% if title %}<h1 class="w-display w-hero-split__title" data-w-split>{{ title }}</h1>{% endif %}
        {% if text %}<p class="w-lead w-hero-split__text" data-w-reveal>{{ text }}</p>{% endif %}
        {% if btn %}
          <div class="w-hero-split__cta" data-w-reveal>
            {% if url and url != '#' %}<a href="{{ url }}" class="w-btn" data-w-magnetic>{{ btn }}</a>
            {% else %}<span class="w-btn">{{ btn }}</span>{% endif %}
          </div>
        {% endif %}
        {% if product %}
          <a href="{{ product.url }}" class="w-hero-split__product" data-w-reveal>
            <span class="w-hero-split__pimg"><img src="{{ product.image.url|default(product.image) }}" alt="{{ product.name|e }}" width="160" height="200" loading="lazy"></span>
            <span class="w-hero-split__pinfo">
              <small>{{ trans('blocks.wareef.shop_the_look') }}</small>
              <b>{{ product.name }}</b>
              <span class="w-hero-split__price">
                {% if product.is_on_sale %}<ins>{{ product.sale_price|money }}</ins> <del>{{ product.regular_price|money }}</del>
                {% else %}<ins>{{ product.price|money }}</ins>{% endif %}
              </span>
            </span>
            <span class="w-hero-split__parrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
