{# Wareef community CTA: striking band inviting visitors to a WhatsApp / Snap community or drop alerts #}
{% set kicker = component.kicker %}{% set kicker = kicker is iterable ? (kicker[language.code]|default(kicker|first)) : kicker %}
{% set title = component.title %}{% set title = title is iterable ? (title[language.code]|default(title|first)) : title %}
{% set text = component.text %}{% set text = text is iterable ? (text[language.code]|default(text|first)) : text %}
{% set btn = component.button %}{% set btn = btn is iterable ? (btn[language.code]|default(btn|first)) : btn %}
{% set mq = component.marquee %}{% set mq = mq is iterable ? (mq[language.code]|default(mq|first)) : mq %}
{% set theme = component.theme %}{% set theme = theme is iterable ? ((theme|first).value|default(theme.value|default('dark'))) : (theme|default('dark')) %}
{% set channel = component.channel %}{% set channel = channel is iterable ? ((channel|first).value|default(channel.value|default('whatsapp'))) : (channel|default('whatsapp')) %}
{% set href = component.link is iterable ? '' : component.link %}
{% if (not href or href == '#') and channel == 'whatsapp' and store.contacts.whatsapp|default('') %}
  {% set href = 'https://wa.me/' ~ store.contacts.whatsapp|replace({'+': '', ' ': ''}) %}
{% endif %}
<section component-id="{{ componentId }}" class="w-block w-block--flush w-community-cta w-community-cta--{{ theme == 'light' ? 'light' : 'dark' }}" data-testid="w-community-cta">
  <div class="w-community-cta__bg" aria-hidden="true">
    <div class="w-community-cta__media" data-w-parallax="0.12">
      <img src="{{ component.image ?: ('images/wareef/editorial.jpg'|asset) }}" alt="" width="1920" height="900" loading="lazy">
    </div>
  </div>
  {% if component.show_marquee and mq %}
    <div class="w-community-cta__outline" aria-hidden="true">
      <div data-w-marquee="40"><div class="w-marquee__track"><span>{{ mq }}</span><span>{{ mq }}</span></div></div>
    </div>
  {% endif %}
  <div class="container w-community-cta__inner">
    <span class="w-community-cta__icon" data-w-reveal="scale" aria-hidden="true">
      {% if channel == 'snapchat' %}
        <svg viewBox="0 0 24 24" width="26" height="26"><path d="M12 3.2c2.9 0 4.9 2.2 4.9 5v2.3c.5.2 1.2 0 1.7-.2.6-.2 1 .6.4 1-.6.4-1.5.6-2 .9.4 1.6 1.8 3 3.5 3.5.5.2.4.8-.1 1-.6.2-1.4.3-1.8.5-.2.4 0 1.1-.6 1.1-.7 0-1.5-.3-2.5 0-1 .3-1.8 1.5-3.5 1.5s-2.5-1.2-3.5-1.5c-1-.3-1.8 0-2.5 0-.6 0-.4-.7-.6-1.1-.4-.2-1.2-.3-1.8-.5-.5-.2-.6-.8-.1-1 1.7-.5 3.1-1.9 3.5-3.5-.5-.3-1.4-.5-2-.9-.6-.4-.2-1.2.4-1 .5.2 1.2.4 1.7.2V8.2c0-2.8 2-5 4.9-5z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
      {% elseif channel == 'instagram' %}
        <svg viewBox="0 0 24 24" width="26" height="26"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.3"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.3"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor"/></svg>
      {% elseif channel == 'bell' %}
        <svg viewBox="0 0 24 24" width="26" height="26"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15zM10 20.5a2 2 0 004 0M12 3v2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {% else %}
        <svg viewBox="0 0 24 24" width="26" height="26"><path d="M4 20l1.2-4.1A8.5 8.5 0 1112 20.5a8.4 8.4 0 01-4-1z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M9 8.5c0 3.3 3.2 6.5 6.5 6.5l1-1.6-2.2-1-.9.9c-1-.4-2.3-1.7-2.7-2.7l.9-.9-1-2.2z" fill="currentColor"/></svg>
      {% endif %}
    </span>
    {% if kicker %}<span class="w-kicker" data-w-reveal="fade">{{ kicker }}</span>{% endif %}
    {% if title %}<h2 class="w-display w-community-cta__title" data-w-split>{{ title }}</h2>{% endif %}
    {% if text %}<p class="w-community-cta__text" data-w-reveal>{{ text }}</p>{% endif %}
    {% if href and href != '#' %}
      <div class="w-community-cta__actions" data-w-reveal>
        <a class="w-btn{{ theme == 'light' ? '' : ' w-btn--light' }}" href="{{ href }}" target="_blank" rel="noopener" data-w-magnetic>{{ btn ?: trans('blocks.wareef.shop_now') }}</a>
      </div>
    {% endif %}
    {% if component.note_text %}<p class="w-community-cta__note" data-w-reveal="fade">{{ component.note_text }}</p>{% endif %}
  </div>
</section>
