{# Wareef press / partners strip: logos in a marquee; elegant text wordmarks when no logo is set #}
{% set title = component.title %}{% set title = title is iterable ? (title[language.code]|default(title|first)) : title %}
{% set speed = component.speed|default(32) %}
{% if component.items|length %}
<section component-id="{{ componentId }}" class="w-block w-press-marquee" data-testid="w-press-marquee">
  <div class="container">
    {% if title %}<h2 class="w-press-marquee__title" data-w-reveal="fade">{{ title }}</h2>{% endif %}
  </div>
  <div class="w-press-marquee__band" data-w-reveal="fade">
    <div data-w-marquee="{{ speed }}">
      <ul class="w-marquee__track" role="list">
        {% for item in component.items %}
          {% set name = item.title is iterable ? (item.title[language.code]|default(item.title|first)) : item.title %}
          {% set href = item.link is iterable ? '' : item.link %}
          <li class="w-press-marquee__item">
            {% if href and href != '#' %}<a href="{{ href }}" target="_blank" rel="noopener" class="w-press-marquee__mark" aria-label="{{ name ?: title }}">{% else %}<span class="w-press-marquee__mark">{% endif %}
              {% if item.logo %}
                <img src="{{ item.logo }}" alt="{{ name ?: title }}" height="44" width="160" loading="lazy">
              {% else %}
                <span class="w-press-marquee__word w-press-marquee__word--{{ loop.index0 % 4 }}" dir="auto">{{ name }}</span>
              {% endif %}
            {% if href and href != '#' %}</a>{% else %}</span>{% endif %}
          </li>
          <li class="w-press-marquee__sep" aria-hidden="true"><svg viewBox="0 0 10 10" width="8" height="8"><path d="M5 0l1.4 3.6L10 5 6.4 6.4 5 10 3.6 6.4 0 5l3.6-1.4z" fill="currentColor"/></svg></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endif %}
