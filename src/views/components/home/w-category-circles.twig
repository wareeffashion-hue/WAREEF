{# Wareef — round category shortcuts in a snap-scrolling row with an animated ring on hover. #}
{% set lang = language.code %}
{% set title = component.title %}{% set title = title is iterable ? (title[lang]|default(title|first)) : title %}
{% set fallbacks = ['look1', 'look2', 'square1', 'look3', 'look4', 'editorial', 'banner', 'hero'] %}
<section component-id="{{ componentId }}" class="w-block w-category-circles" data-testid="w-category-circles">
  <div class="container">
    {% if title %}<h2 class="w-category-circles__title" data-w-reveal>{{ title }}</h2>{% endif %}
    <ul class="w-category-circles__row" data-w-stagger>
      {% for item in component.items %}
        {% set t = item.title %}{% set t = t is iterable ? (t[lang]|default(t|first)) : t %}
        {% set url = item.url %}{% set has_url = url and url != '#' %}
        {% set tag = has_url ? 'a' : 'div' %}
        <li class="w-category-circles__item" data-w-reveal="scale">
          <{{ tag }}{% if has_url %} href="{{ url }}"{% endif %} class="w-category-circles__link">
            <span class="w-category-circles__disc">
              <svg class="w-category-circles__ring" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="49" pathLength="100"/></svg>
              <span class="w-category-circles__img">
                <img src="{{ item.image ?: ('images/wareef/' ~ fallbacks[loop.index0 % 8] ~ '.jpg')|asset }}" alt="{{ t }}" width="160" height="160" loading="lazy">
              </span>
            </span>
            {% if t %}<span class="w-category-circles__name">{{ t }}</span>{% endif %}
          </{{ tag }}>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
