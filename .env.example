# Public URL (used in the tracking snippet and webhook URLs). Use a subdomain of
# the store when possible (e.g. https://t.mystore.com) so ad blockers block it less.
PUBLIC_URL=https://track.example.com

# Required in production: encrypts ad platform tokens at rest. `openssl rand -hex 32`
SECRET_KEY=

# Optional: create the first admin on boot (otherwise the first visit shows a setup page).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 1 when served over HTTPS (marks the session cookie Secure).
SECURE_COOKIES=1

TZ_OFFSET=+03:00
SYNC_INTERVAL_MINUTES=60

# OAuth apps, only needed to refresh tokens for these platforms.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# API versions (platforms retire old versions regularly).
META_API_VERSION=v25.0
GOOGLE_ADS_API_VERSION=v24
