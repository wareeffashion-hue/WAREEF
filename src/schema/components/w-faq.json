      "value": [
        {
          "items.question": "كيف أختار المقاس المناسب؟",
          "items.answer": "ستجدين جدول المقاسات في صفحة كل منتج، ويعتمد على الطول وعرض الكتف. وإن احترتِ بين مقاسين ننصحك بالأكبر للحصول على انسيابية أجمل."
        },
        {
          "items.question": "كم تستغرق مدة التوصيل؟",
          "items.answer": "يصل طلبك خلال ٢–٥ أيام عمل داخل المملكة، وتصلك رسالة برقم الشحنة فور خروج الطلب من مشغلنا."
        },
        {
          "items.question": "هل يمكنني استبدال أو إرجاع القطعة؟",
          "items.answer": "نعم، خلال ١٤ يومًا من الاستلام بشرط أن تكون القطعة بحالتها الأصلية مع البطاقة والتغليف."
        },
        {
          "items.question": "هل تقدّمون تفصيلًا حسب الطلب؟",
          "items.answer": "نوفّر تعديل الطول على عدد من التصاميم، ويمكنك إضافة ملاحظتك عند إتمام الطلب."
        },
        {
          "items.question": "ما طرق الدفع المتاحة؟",
          "items.answer": "الدفع بالبطاقات البنكية ومدى وأبل باي، إضافة إلى خيارات التقسيط المتاحة عند الدفع."
        }
      ]
    }
